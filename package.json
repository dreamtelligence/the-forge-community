{
  "name": "the-forge-community",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "24.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "next dev",
    "check:architecture": "node scripts/architecture/check-architecture.mjs",
    "check:migrations": "node scripts/architecture/check-architecture.mjs --migrations-only",
    "build": "npm run check:architecture && prisma generate && next build",
    "start": "next start",
    "lint": "npm run check:architecture && eslint",
    "migrate:deploy": "npm run check:migrations && bash scripts/db/migrate-unpooled.sh",
    "seed:academy": "node scripts/seed/seed-academy-local.mjs",
    "seed:platform-finance": "node scripts/seed/seed-platform-finance.mjs",
    "export:platform-ledger": "node scripts/exports/export-platform-ledger.mjs",
    "test:smoke": "tsx scripts/smoke-tests/run-all-tests.ts",
    "test:smoke:auth-tenant": "tsx scripts/smoke-tests/test-auth-tenant.ts",
    "test:smoke:image": "tsx scripts/smoke-tests/test-image-generation.ts",
    "test:smoke:video": "tsx scripts/smoke-tests/test-video-generation.ts",
    "test:smoke:effects": "tsx scripts/smoke-tests/test-video-effects.ts",
    "test:smoke:warehouse": "tsx scripts/smoke-tests/test-warehouse-wms.ts",
    "test:warehouse:boundary": "node --import tsx scripts/tests/test-warehouse-boundary.ts",
    "test:marketing:media": "node --import tsx scripts/tests/test-marketing-media-flow.ts",
    "test:legacy:replicate": "node --import tsx scripts/tests/test-legacy-replicate-job-flow.ts",
    "test:webhook:replicate": "node --import tsx scripts/tests/test-replicate-webhook-receipt.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/react": "^4.0.167",
    "@auth/pg-adapter": "^1.11.1",
    "@auth/prisma-adapter": "^2.11.1",
    "@google/genai": "^1.49.0",
    "@marsidev/react-turnstile": "^1.5.0",
    "@notionhq/client": "^5.17.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-pdf/renderer": "^4.4.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@vercel/blob": "^2.3.3",
    "@vercel/postgres": "^0.10.0",
    "ai": "^7.0.163",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-ease": "^3.0.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.1",
    "emoji-picker-react": "^4.18.0",
    "framer-motion": "^12.38.0",
    "gsa": "^0.0.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.21",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "^16.2.3",
    "next-auth": "^5.0.0-beta.30",
    "ogl": "^1.0.11",
    "pg": "^8.20.0",
    "postprocessing": "^6.39.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "replicate": "^1.4.0",
    "resend": "^6.10.0",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      ".": "1.29.0",
      "@hono/node-server": "1.19.13",
      "ajv": "8.18.0"
    },
    "@prisma/dev": {
      "@hono/node-server": "1.19.13"
    },
    "flat-cache": {
      "flatted": "3.4.2"
    },
    "minimatch@3": {
      "brace-expansion": "1.1.13"
    },
    "tinyglobby": {
      "picomatch": "4.0.4"
    },
    "@typescript-eslint/typescript-estree": {
