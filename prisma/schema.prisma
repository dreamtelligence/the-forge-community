  aiSummary       String?

  // Cache control
  fetchedAt       DateTime @default(now())
  expiresAt       DateTime? // Cache expiry

  @@index([url])
  @@index([fetchedAt])
}

model SystemCache {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

