# Use your own development database. Never commit real values.
DATABASE_URL=postgresql://forge:local-password@localhost:5432/forge
DIRECT_URL=postgresql://forge:local-password@localhost:5432/forge
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate a random AUTH_SECRET; configure an actual Resend sender.
AUTH_SECRET=
AUTH_RESEND_KEY=
AUTH_RESEND_FROM=
# Optional Google login
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
INITIAL_CREDITS=0

# Enable only the AI providers you intend to use (paid requests).
GEMINI_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
REPLICATE_WEBHOOK_SECRET=
BLOB_READ_WRITE_TOKEN=

# Encrypt stored integration credentials with a random 32-byte hex key.
INTEGRATION_ENCRYPTION_KEY=

# Billing: use your own Stripe test account and configured price allowlists.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOWED_SUBSCRIPTION_PRICE_IDS=
STRIPE_ALLOWED_CREDIT_PRICE_IDS=
STRIPE_CREDIT_PRICE_MAP=
